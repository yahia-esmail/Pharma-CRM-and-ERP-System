@using Microsoft.Extensions.Options
@using PharmaERP.FieldApp.UI.Services
@implements IDisposable
@inject ILocationService Location
@inject LocationTracker Tracker
@inject IOptions<GpsOptions> Gps

@*
  Event fix with live feedback (plan 7.3): "Locating… 45 m → 18 m". Stops by itself at the target accuracy;
  after a few seconds the rep may settle for the current reading. This is what check-in, orders and
  collections use (phase 6+); the diagnostics page uses it to evaluate phones in the field.
*@
<div class="location-capture">
    @if (_busy)
    {
        <div class="capture-progress" role="status">
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            <span>Locating… @(_bestAccuracy is { } a ? $"accuracy {a:0} m" : "waiting for GPS")</span>
        </div>
        @if (_canAccept)
        {
            <button class="btn btn-sm btn-outline-secondary mt-2" @onclick="AcceptCurrentAsync">Use current (@(_bestAccuracy?.ToString("0") ?? "?") m)</button>
        }
    }
    else
    {
        <button class="btn btn-primary w-100" @onclick="CaptureAsync" disabled="@Disabled">@ButtonText</button>
        @if (_result is { Succeeded: false } failed)
        {
            <p class="small text-danger mt-2 mb-0">@failed.UserMessage</p>
        }
    }
</div>

@code {
    private static readonly TimeSpan AcceptOfferDelay = TimeSpan.FromSeconds(5);

    [Parameter] public string ButtonText { get; set; } = "Get my location";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<GeoFix> OnCaptured { get; set; }

    /// <summary>No fix (denied, unavailable, timeout) — lets the caller offer a way to continue without one.</summary>
    [Parameter] public EventCallback<GeoFixResult> OnFailed { get; set; }

    private bool _busy;
    private bool _canAccept;
    private double? _bestAccuracy;
    private GeoFixResult? _result;
    private CancellationTokenSource? _offerTimer;

    private async Task CaptureAsync()
    {
        _busy = true;
        _canAccept = false;
        _bestAccuracy = null;
        _result = null;
        _offerTimer = new CancellationTokenSource();
        _ = OfferAcceptLaterAsync(_offerTimer.Token);

        var progress = new Progress<double>(accuracy =>
        {
            _bestAccuracy = accuracy;
            StateHasChanged();
        });
        try
        {
            _result = await Location.GetBestFixAsync(Gps.Value.TargetAccuracyMeters, Gps.Value.MaxWaitMs, progress);
        }
        finally
        {
            _offerTimer.Cancel();
            _busy = false;
        }

        if (_result.Fix is { } fix)
        {
            await Tracker.RecordEventFixAsync(fix);
            await OnCaptured.InvokeAsync(fix);
        }
        else
        {
            if (_result.Error == GeoError.Denied) await Tracker.ReportPermissionDeniedAsync();
            await OnFailed.InvokeAsync(_result);
        }
    }

    private async Task OfferAcceptLaterAsync(CancellationToken ct)
    {
        try
        {
            await Task.Delay(AcceptOfferDelay, ct);
            _canAccept = _bestAccuracy is not null;
            await InvokeAsync(StateHasChanged);
            // No reading yet at 5 s: offer as soon as the first one arrives.
            while (!_canAccept && !ct.IsCancellationRequested)
            {
                await Task.Delay(500, ct);
                if (_bestAccuracy is not null)
                {
                    _canAccept = true;
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (TaskCanceledException) { }
    }

    private Task AcceptCurrentAsync() => Location.AcceptCurrentFixAsync();

    public void Dispose()
    {
        _offerTimer?.Cancel();
        if (_busy) _ = Location.AcceptCurrentFixAsync();   // don't leave the GPS on after navigating away
    }
}
