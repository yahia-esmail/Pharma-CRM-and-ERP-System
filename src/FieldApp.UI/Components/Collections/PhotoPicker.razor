@* Receipt / proof-of-payment photos (wireframes 10–12). Opens the rear camera on phones (capture="environment");
   each photo is re-encoded as JPEG on the phone — 1600 px, smaller if needed — so a 4 MB camera shot is stored and
   sent as a few hundred KB. *@
<div class="photo-picker">
    @foreach (var slot in Slots)
    {
        var photo = Photos.FirstOrDefault(p => p.Label == slot);
        <div class="photo-slot @(photo is null ? "empty" : "")">
            @if (photo is not null)
            {
                <img src="@photo.DataUrl" alt="@slot" />
                <button type="button" class="photo-remove" aria-label="Remove @slot" @onclick="() => RemoveAsync(photo)">×</button>
                <span class="photo-label">@slot · @(photo.SizeBytes / 1024) KB</span>
            }
            else
            {
                <label class="photo-add">
                    <InputFile accept="image/*" capture="environment" OnChange="e => AddAsync(e, slot)" disabled="@(_busy is not null)" />
                    <span class="photo-plus" aria-hidden="true">@(_busy == slot ? "…" : "+")</span>
                    <span class="photo-label">@slot</span>
                </label>
            }
        </div>
    }
    @if (_error is not null)
    {
        <div class="small text-danger w-100">@_error</div>
    }
</div>

@code {
    // Largest side first; a photo still over the budget is re-encoded smaller (plan phase 9: a 4 MB camera shot
    // must end up under 400 KB and stay readable).
    private static readonly int[] Sides = [1600, 1280, 1024, 800];
    private const long TargetBytes = 380 * 1024;
    private const long MaxCameraFileBytes = 25 * 1024 * 1024;

    [Parameter, EditorRequired] public IReadOnlyList<string> Slots { get; set; } = [];
    [Parameter] public List<CollectionPhoto> Photos { get; set; } = [];
    [Parameter] public EventCallback PhotosChanged { get; set; }

    private string? _busy;
    private string? _error;

    private async Task AddAsync(InputFileChangeEventArgs e, string slot)
    {
        _error = null;
        _busy = slot;
        try
        {
            byte[] bytes = [];
            foreach (var side in Sides)
            {
                var resized = await e.File.RequestImageFileAsync("image/jpeg", side, side);
                await using var stream = resized.OpenReadStream(MaxCameraFileBytes);
                using var buffer = new MemoryStream();
                await stream.CopyToAsync(buffer);
                bytes = buffer.ToArray();
                if (bytes.Length <= TargetBytes) break;
            }
            Photos.RemoveAll(p => p.Label == slot);
            Photos.Add(new CollectionPhoto(slot, $"{slot}.jpg", "image/jpeg", Convert.ToBase64String(bytes)));
            await PhotosChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            _error = $"Couldn't use that photo ({ex.Message}). Try taking it again.";
        }
        finally
        {
            _busy = null;
        }
    }

    private async Task RemoveAsync(CollectionPhoto photo)
    {
        Photos.Remove(photo);
        await PhotosChanged.InvokeAsync();
    }
}
