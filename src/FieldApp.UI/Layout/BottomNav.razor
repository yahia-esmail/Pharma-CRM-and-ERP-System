@code {
    // Always on screen, so it also owns the app-wide notification plumbing: keeping the badge current, and
    // following a tapped phone notification into the app while it's open.
    protected override async Task OnInitializedAsync()
    {
        Notifications.Changed += OnChanged;
        Network.Changed += OnNetworkChanged;
        Push.PushReceived += OnPushReceived;
        Push.OpenRequested += OnOpenRequested;
        await Notifications.EnsureLoadedAsync();
        await Push.StartListeningAsync();
        if (Network.IsOnline) await Notifications.RefreshAsync();
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void OnPushReceived() => _ = InvokeAsync(() => Notifications.RefreshAsync());

    private void OnOpenRequested(string path) => InvokeAsync(() => Navigation.NavigateTo(path));

    private void OnNetworkChanged(bool online)
    {
        if (online) _ = InvokeAsync(() => Notifications.RefreshAsync());
    }

    public void Dispose()
    {
        Notifications.Changed -= OnChanged;
        Network.Changed -= OnNetworkChanged;
        Push.PushReceived -= OnPushReceived;
        Push.OpenRequested -= OnOpenRequested;
    }
}
