        <span>Home</span>
    </NavLink>
    <NavLink class="bottom-nav-item" href="plan">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z" /></svg>
        <span>Plan</span>
    </NavLink>
    <NavLink class="bottom-nav-item" href="orders">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 2h9l5 5v14a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1zm8 1.5V8h4.5M8 12h8M8 16h8" fill="none" stroke="currentColor" stroke-width="1.8" /></svg>
