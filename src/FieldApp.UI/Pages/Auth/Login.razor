@page "/login"
@layout AuthLayout
@attribute [AllowAnonymous]
@inject AuthService Auth
@inject TokenStore Tokens
@inject NavigationManager Navigation
@inject PasskeyService Passkeys

<PageTitle>Sign in · Field CRM</PageTitle>

<div class="auth-card">
    <div class="auth-brand">
        <div class="auth-logo" aria-hidden="true">F</div>
        <h1>Field CRM</h1>
        <p class="text-secondary">Sign in to start your day</p>
    </div>

    <EditForm Model="_model" OnValidSubmit="SignInAsync" FormName="login">
        <DataAnnotationsValidator />

        <div class="mb-3">
            <label class="form-label" for="email">Email</label>
            <InputText id="email" class="form-control form-control-lg" type="email" autocomplete="username"
                       inputmode="email" @bind-Value="_model.Email" disabled="@_busy" />
            <ValidationMessage For="() => _model.Email" />
        </div>

        <div class="mb-3">
            <label class="form-label" for="password">Password</label>
            <div class="input-group">
                <InputText id="password" class="form-control form-control-lg" type="@(_showPassword ? "text" : "password")"
                           autocomplete="current-password" @bind-Value="_model.Password" disabled="@_busy" />
                <button type="button" class="btn btn-outline-secondary" @onclick="() => _showPassword = !_showPassword">
                    @(_showPassword ? "Hide" : "Show")
                </button>
            </div>
            <ValidationMessage For="() => _model.Password" />
        </div>

        @if (_error is not null)
        {
            <div class="alert alert-danger py-2" role="alert">@_error</div>
        }

        <button type="submit" class="btn btn-primary btn-lg w-100" disabled="@_busy">
            @(_busy ? "Signing in…" : "Sign In")
        </button>
    </EditForm>

    @if (_passkeyAvailable)
    {
        <div class="auth-divider"><span>or</span></div>
        <button type="button" class="btn btn-outline-primary btn-lg w-100" @onclick="PasskeySignInAsync" disabled="@_busy">
            <svg class="me-2" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a9 9 0 0 0-9 9v1h2v-1a7 7 0 0 1 14 0v4a5 5 0 0 1-1 3l1.6 1.2A7 7 0 0 0 21 15v-4a9 9 0 0 0-9-9zm0 4a5 5 0 0 0-5 5v3a9 9 0 0 1-1.6 5.2L7 20.4A11 11 0 0 0 9 14v-3a3 3 0 0 1 6 0v3a15 15 0 0 1-1.4 6.4l1.8.9A17 17 0 0 0 17 14v-3a5 5 0 0 0-5-5zm-1 5v3a13 13 0 0 1-2.6 7.8l1.6 1.2A15 15 0 0 0 13 14v-3z"/></svg>
            Sign in with fingerprint
        </button>
        <p class="small text-secondary text-center mt-2 mb-0">Set it up once from the home screen after signing in with your password.</p>
    }
    @* "Forgot password" needs a reset flow in the API first. *@
</div>

@code {
    private readonly LoginModel _model = new();
    private bool _busy;
    private bool _showPassword;
    private string? _error;
    private bool _passkeyAvailable;

    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await Tokens.InitializeAsync();
        if (Tokens.Session is not null) { GoBack(); return; }
        _passkeyAvailable = await Passkeys.IsAvailableAsync();
    }

    private async Task PasskeySignInAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var outcome = await Auth.LoginWithPasskeyAsync();
            _error = outcome switch
            {
                PasskeyOutcome.Succeeded or PasskeyOutcome.Cancelled => null,
                PasskeyOutcome.NotARepresentative => "This app is for field representatives. Please use the web portal.",
                PasskeyOutcome.Rejected => "Fingerprint sign-in didn't work — sign in with your password (and set it up again from the home screen).",
                PasskeyOutcome.Unsupported => "This phone can't sign in with a fingerprint.",
                _ => "Can't reach the server. Check your connection and try again."
            };
            if (outcome == PasskeyOutcome.Succeeded) GoBack();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SignInAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var outcome = await Auth.LoginAsync(_model.Email, _model.Password);
            _error = outcome switch
            {
                LoginOutcome.Succeeded => null,
                LoginOutcome.InvalidCredentials => "Incorrect email or password.",
                LoginOutcome.NotARepresentative => "This app is for field representatives. Please use the web portal.",
                _ => "Can't reach the server. Check your connection and try again — the first sign-in needs internet."
            };
            if (outcome == LoginOutcome.Succeeded) GoBack();
        }
        finally
        {
            _busy = false;
        }
    }

    private void GoBack()
    {
        // Only follow local return URLs, never an absolute one smuggled into the query string.
        var target = !string.IsNullOrEmpty(ReturnUrl) && !ReturnUrl.Contains("://") && !ReturnUrl.StartsWith("//")
            ? ReturnUrl
            : "";
        Navigation.NavigateTo(target, replace: true);
    }

    private sealed class LoginModel
    {
        [System.ComponentModel.DataAnnotations.Required, System.ComponentModel.DataAnnotations.EmailAddress]
        public string Email { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required]
        public string Password { get; set; } = "";
    }
}
