<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <!-- No fingerprinted file names: they need an inline <script type="importmap">, which the Content-Security-Policy
         (index.html) doesn't allow. Updates still arrive — the service worker re-fetches every asset with
         cache:'no-cache' on install, checks it against the hash in service-worker-assets.js, and keeps it in a cache
         named after that version. Hosts must serve _framework/ with revalidation (no long max-age). -->
    <WasmFingerprintAssets>false</WasmFingerprintAssets>
    <!-- The UI is English only: no ICU culture data to download, and dates/numbers look the same whatever language
         the phone is set to (an Arabic phone no longer gets Arabic month names in an English screen). -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Ship web.config (IIS: Brotli, security headers, revalidation — see the file). The SDK leaves it out for
         browser-wasm unless asked. -->
    <PublishIISAssets>true</PublishIISAssets>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.9" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FieldApp.UI\PharmaERP.FieldApp.UI.csproj" />
  </ItemGroup>

</Project>
