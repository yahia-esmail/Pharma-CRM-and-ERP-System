@model LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    Layout = "_LoginLayout";
}

<div class="login-card card mx-auto mt-5" style="max-width: 400px;">
    <div class="card-body p-4">
        <div class="text-center mb-4">
            <i class="bi bi-capsule-pill fs-1 text-primary"></i>
            <h4 class="mt-2 mb-0">Pharma CRM/ERP</h4>
            <small class="text-secondary">Sign in to continue</small>
        </div>

        <form asp-controller="Account" asp-action="Login" method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <div class="form-floating mb-3">
                <input asp-for="Email" class="form-control" placeholder="name@company.com" autofocus />
                <label asp-for="Email"></label>
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Password" class="form-control" placeholder="Password" />
                <label asp-for="Password"></label>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="form-check mb-3">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label"></label>
            </div>
            <button type="submit" class="btn btn-primary w-100">Sign In</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
