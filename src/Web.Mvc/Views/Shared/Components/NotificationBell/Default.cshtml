@model PharmaERP.Web.Mvc.ViewComponents.NotificationBellViewModel

<div class="dropdown me-2">
    <button class="btn btn-sm btn-light position-relative" type="button" data-bs-toggle="dropdown" aria-expanded="false">
        <i class="bi bi-bell"></i>
        @if (Model.UnreadCount > 0)
        {
            <span id="notificationBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                @(Model.UnreadCount > 99 ? "99+" : Model.UnreadCount.ToString())
            </span>
        }
        else
        {
            <span id="notificationBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" hidden></span>
        }
    </button>
    <div class="dropdown-menu dropdown-menu-end p-0" style="width: 360px; max-height: 420px; overflow-y: auto;">
        <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom">
            <span class="fw-semibold">Notifications</span>
            <a asp-controller="Notifications" asp-action="Index" class="small">View all</a>
        </div>
        @foreach (var n in Model.Recent)
        {
            <div class="px-3 py-2 border-bottom small @(n.IsRead ? "text-secondary" : "fw-semibold")">
                <div>@n.Message</div>
                <div class="text-secondary" style="font-size: 0.75rem;">@n.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</div>
            </div>
        }
        @if (Model.Recent.Count == 0)
        {
            <div class="px-3 py-3 text-center text-secondary small">No notifications yet.</div>
        }
    </div>
</div>
