@model PagedResult<SaleListItemDto>
@{
    ViewData["Title"] = "Sales History";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Sales History</h4>
    <a asp-action="Export" asp-route-fromDate="@ViewBag.FromDate" asp-route-toDate="@ViewBag.ToDate" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-file-earmark-spreadsheet"></i> Export to Excel
    </a>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2">
            <div class="col-md-3">
                <input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-control" />
            </div>
            <div class="col-md-3">
                <input type="date" name="toDate" value="@ViewBag.ToDate" class="form-control" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-outline-secondary w-100">Filter</button>
            </div>
        </form>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="card kpi-tile p-3">
            <div class="kpi-label">Total Sales (this page)</div>
            <div class="kpi-value text-primary">@Model.Items.Sum(s => s.TotalAmount).ToString("C")</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card kpi-tile p-3">
            <div class="kpi-label">Transactions</div>
            <div class="kpi-value text-primary">@Model.TotalCount</div>
        </div>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Date</th><th>Pharmacy</th><th>Representative</th><th>Order #</th><th>Amount</th></tr></thead>
            <tbody>
                @foreach (var s in Model.Items)
                {
                    <tr style="cursor:pointer;" onclick="location.href='@Url.Action("Details", "Orders", new { id = s.OrderId })'">
                        <td>@s.SaleDateUtc.ToString("yyyy-MM-dd")</td>
                        <td>@s.PharmacyName</td>
                        <td>@s.RepresentativeName</td>
                        <td>#@s.OrderId</td>
                        <td>@s.TotalAmount.ToString("C")</td>
                    </tr>
                }
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-secondary py-4">No sales in this period.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination pagination-sm">
            @for (var p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { page = p, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate })">@p</a>
                </li>
            }
        </ul>
    </nav>
}
