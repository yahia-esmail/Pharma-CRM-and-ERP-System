@model IReadOnlyList<NotificationDto>
@{
    ViewData["Title"] = "Notifications";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Notifications</h4>
    <form asp-action="MarkAllRead" method="post">
        <button type="submit" class="btn btn-outline-secondary btn-sm"><i class="bi bi-check2-all"></i> Mark all read</button>
    </form>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-sm mb-0">
            <thead><tr><th>Date</th><th>Type</th><th>Message</th><th></th></tr></thead>
            <tbody>
                @foreach (var n in Model)
                {
                    <tr class="@(n.IsRead ? "" : "fw-semibold")">
                        <td class="text-nowrap">@n.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                        <td><span class="badge bg-secondary status-badge">@n.Type</span></td>
                        <td>@n.Message</td>
                        <td class="text-end">
                            @if (!n.IsRead)
                            {
                                <form asp-action="MarkRead" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@n.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">Mark read</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="4" class="text-center text-secondary py-4">No notifications yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
