@model PagedResult<SupplierListItemDto>
@{
    ViewData["Title"] = "Suppliers";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Suppliers</h4>
    <div class="d-flex gap-2">
        <a asp-controller="PurchaseOrders" asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-clipboard-data"></i> Purchase Orders</a>
        @if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Procurement))
        {
            <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> Add Supplier</a>
        }
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2">
            <div class="col-md-4">
                <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by name..." />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-outline-secondary w-100"><i class="bi bi-search"></i> Filter</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Name</th><th>Contact</th><th>Phone</th><th>Outstanding Payable</th><th>Status</th></tr></thead>
            <tbody>
                @foreach (var s in Model.Items)
                {
                    <tr style="cursor:pointer;" onclick="location.href='@Url.Action("Details", new { id = s.Id })'">
                        <td>@s.Name</td>
                        <td>@s.ContactName</td>
                        <td>@s.Phone</td>
                        <td class="@(s.OutstandingBalance > 0 ? "text-danger fw-semibold" : "")">@s.OutstandingBalance.ToString("C")</td>
                        <td><span class="badge @(s.Status == PharmaERP.Domain.Enums.SupplierStatus.Active ? "bg-success" : "bg-secondary") status-badge">@s.Status</span></td>
                    </tr>
                }
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-secondary py-4">No suppliers found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination pagination-sm">
            @for (var p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { page = p, search = ViewBag.Search })">@p</a>
                </li>
            }
        </ul>
    </nav>
}
