@model SupplierDetailsViewModel
@{
    ViewData["Title"] = Model.Supplier.Name;
    var s = Model.Supplier;
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h4 class="mb-0">@s.Name</h4>
        <div class="text-secondary">@s.ContactName</div>
    </div>
    <div class="d-flex gap-2">
        @if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Procurement))
        {
            <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-outline-secondary btn-sm"><i class="bi bi-pencil"></i> Edit</a>
            <a asp-controller="PurchaseOrders" asp-action="Create" asp-route-supplierId="@s.Id" class="btn btn-primary btn-sm"><i class="bi bi-cart-plus"></i> New PO</a>
        }
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Phone</dt><dd class="col-sm-8">@s.Phone</dd>
                    <dt class="col-sm-4">Email</dt><dd class="col-sm-8">@s.Email</dd>
                    <dt class="col-sm-4">Tax Registration #</dt><dd class="col-sm-8">@s.TaxRegistrationNumber</dd>
                    <dt class="col-sm-4">Payment Terms</dt><dd class="col-sm-8">@s.PaymentTermDays days</dd>
                    <dt class="col-sm-4">Status</dt><dd class="col-sm-8"><span class="badge @(s.Status == PharmaERP.Domain.Enums.SupplierStatus.Active ? "bg-success" : "bg-secondary") status-badge">@s.Status</span></dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card kpi-tile p-3 text-center">
            <div class="kpi-label">Outstanding Payable</div>
            <div class="kpi-value @(Model.Ledger.OutstandingBalance > 0 ? "text-danger" : "text-success")">@Model.Ledger.OutstandingBalance.ToString("C")</div>
        </div>
    </div>
</div>

<ul class="nav nav-tabs">
    <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#orders">Purchase Orders (@Model.PurchaseOrders.Count)</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#ledger">Ledger</button></li>
    @if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Procurement))
    {
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#payment">Record Payment</button></li>
    }
</ul>

<div class="tab-content border border-top-0 p-3 bg-white">
    <div class="tab-pane fade show active" id="orders">
        <table class="table table-sm">
            <thead><tr><th>Date</th><th>Status</th><th>Total</th></tr></thead>
            <tbody>
                @foreach (var o in Model.PurchaseOrders)
                {
                    <tr style="cursor:pointer;" onclick="location.href='@Url.Action("Details", "PurchaseOrders", new { id = o.Id })'">
                        <td>@o.OrderDateUtc.ToString("yyyy-MM-dd")</td>
                        <td><span class="badge bg-info status-badge">@o.Status</span></td>
                        <td>@o.TotalAmount.ToString("C")</td>
                    </tr>
                }
                @if (Model.PurchaseOrders.Count == 0)
                {
                    <tr><td colspan="3" class="text-center text-secondary py-3">No purchase orders yet.</td></tr>
                }
            </tbody>
        </table>
    </div>

    <div class="tab-pane fade" id="ledger">
        <table class="table table-sm">
            <thead><tr><th>Date</th><th>Type</th><th>Reference</th><th>Amount</th></tr></thead>
            <tbody>
                @foreach (var l in Model.Ledger.Lines)
                {
                    <tr>
                        <td>@l.DateUtc.ToString("yyyy-MM-dd")</td>
                        <td>@l.Type</td>
                        <td>@l.Reference</td>
                        <td class="@(l.Amount < 0 ? "text-success" : "")">@l.Amount.ToString("C")</td>
                    </tr>
                }
                @if (Model.Ledger.Lines.Count == 0)
                {
                    <tr><td colspan="4" class="text-center text-secondary py-3">No transactions yet.</td></tr>
                }
            </tbody>
        </table>
    </div>

    @if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Procurement))
    {
        <div class="tab-pane fade" id="payment">
            <form asp-action="AddPayment" method="post" class="row g-2">
                <input type="hidden" asp-for="NewPayment.SupplierId" />
                <div class="col-md-3">
                    <label class="form-label">Amount</label>
                    <input asp-for="NewPayment.Amount" type="number" step="0.01" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Method</label>
                    <select asp-for="NewPayment.PaymentMethod" asp-items="Html.GetEnumSelectList<PharmaERP.Domain.Enums.PaymentMethod>()" class="form-select"></select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Reference #</label>
                    <input asp-for="NewPayment.ReferenceNumber" class="form-control" />
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary btn-sm w-100">Record Payment</button>
                </div>
            </form>
        </div>
    }
</div>
