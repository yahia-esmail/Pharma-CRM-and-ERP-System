@model DoctorIndexViewModel
@{
    ViewData["Title"] = "Doctors";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Doctors</h4>
    @if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.SalesManager) || User.IsInRole(Roles.DistrictManager) || User.IsInRole(Roles.Representative))
    {
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> Add Doctor</a>
    }
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2">
            <div class="col-md-4">
                <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Search by name or clinic..." />
            </div>
            <div class="col-md-3">
                <input type="text" name="specialty" value="@Model.Specialty" class="form-control" placeholder="Specialty" />
            </div>
            <div class="col-md-3">
                <input type="text" name="city" value="@Model.City" class="form-control" placeholder="City" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-outline-secondary w-100"><i class="bi bi-search"></i> Filter</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Specialty</th>
                    <th>City</th>
                    <th>Classification</th>
                    <th>Representative</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model.Result.Items)
                {
                    <tr class="cursor-pointer" onclick="location.href='@Url.Action("Details", new { id = d.Id })'" style="cursor:pointer;">
                        <td>@d.FullName</td>
                        <td>@d.Specialty</td>
                        <td>@d.City</td>
                        <td>@d.ClassificationName</td>
                        <td>@d.PrimaryRepresentativeName</td>
                        <td>
                            @{
                                var badgeClass = d.Status switch
                                {
                                    PharmaERP.Domain.Enums.DoctorStatus.Active => "bg-success",
                                    PharmaERP.Domain.Enums.DoctorStatus.Prospect => "bg-info",
                                    _ => "bg-secondary"
                                };
                            }
                            <span class="badge @badgeClass status-badge">@d.Status</span>
                        </td>
                    </tr>
                }
                @if (Model.Result.Items.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-secondary py-4">No doctors found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.Result.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination pagination-sm">
            @for (var p = 1; p <= Model.Result.TotalPages; p++)
            {
                <li class="page-item @(p == Model.Result.PageNumber ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { page = p, search = Model.Search, specialty = Model.Specialty, city = Model.City })">@p</a>
                </li>
            }
        </ul>
    </nav>
}
