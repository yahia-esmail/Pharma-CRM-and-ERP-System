@model TerritoryFormViewModel

<input type="hidden" asp-for="Id" />
<div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Region" class="form-label"></label>
        <input asp-for="Region" class="form-control" />
    </div>
    <div class="col-md-6">
        <label asp-for="Type" class="form-label"></label>
        <select asp-for="Type" asp-items="Html.GetEnumSelectList<PharmaERP.Domain.Enums.TerritoryType>()" class="form-select"></select>
    </div>
    <div class="col-md-6">
        <label asp-for="ParentTerritoryId" class="form-label">Parent Territory</label>
        <select asp-for="ParentTerritoryId" asp-items="Model.ParentTerritories" class="form-select">
            <option value="">-- top level --</option>
        </select>
    </div>
    <div class="col-md-6">
        <label asp-for="DistrictManagerId" class="form-label"></label>
        <select asp-for="DistrictManagerId" asp-items="Model.Managers" class="form-select">
            <option value="">-- none --</option>
        </select>
    </div>
    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
    </div>
</div>

<div class="mt-4 d-flex gap-2">
    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Save</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</div>
