@model CustomerListDetailDto
@{
    ViewData["Title"] = Model.Name;
    var addForm = ViewBag.AddMemberForm as ListAddMemberViewModel;
    var bulkForm = ViewBag.BulkAssignForm as BulkAssignViewModel;
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h4 class="mb-1">@Model.Name</h4>
        <span class="badge bg-secondary status-badge">@Model.Type</span>
        <span class="badge @(Model.Mode == CustomerListMode.Static ? "bg-info" : "bg-dark") status-badge">@Model.Mode</span>
    </div>
    @if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.SalesManager) || User.IsInRole(Roles.DistrictManager))
    {
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm"><i class="bi bi-pencil"></i> Edit</a>
    }
</div>

@if (Model.Mode == CustomerListMode.Dynamic)
{
    <div class="card mb-3">
        <div class="card-body">
            <h6 class="text-secondary">Dynamic filter</h6>
            <dl class="row mb-0">
                <dt class="col-sm-2">Territory</dt><dd class="col-sm-4">@(Model.FilterTerritoryName ?? "any")</dd>
                <dt class="col-sm-2">Classification</dt><dd class="col-sm-4">@(Model.FilterClassificationName ?? "any")</dd>
                <dt class="col-sm-2">Segment</dt><dd class="col-sm-4">@(Model.FilterSegment ?? "any")</dd>
                <dt class="col-sm-2">Active only</dt><dd class="col-sm-4">@(Model.FilterActiveOnly ? "Yes" : "No")</dd>
            </dl>
        </div>
    </div>
}

<div class="row g-3 mb-3">
    @if (addForm is not null)
    {
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <h6 class="card-title">Add Customer</h6>
                    <form asp-action="AddMember" method="post" class="row g-2">
                        <input type="hidden" name="listId" value="@Model.Id" />
                        <div class="col-12">
                            <label class="form-label">Doctor</label>
                            <select name="doctorId" asp-items="addForm.Doctors" class="form-select">
                                <option value="">-- select --</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label">or Pharmacy</label>
                            <select name="pharmacyId" asp-items="addForm.Pharmacies" class="form-select">
                                <option value="">-- select --</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-plus-lg"></i> Add</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
    @if (bulkForm is not null && (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.SalesManager) || User.IsInRole(Roles.DistrictManager)))
    {
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <h6 class="card-title">Bulk Assign to Representative</h6>
                    <p class="text-secondary small">Reassigns every customer currently in this list to one representative in a single action, logging a transfer entry for anyone who already had a different owner.</p>
                    <form asp-action="BulkAssign" method="post" class="row g-2" onsubmit="return confirm('Reassign all @Model.Members.Count customer(s) in this list?');">
                        <input type="hidden" name="ListId" value="@Model.Id" />
                        <div class="col-12">
                            <label class="form-label">Representative</label>
                            <select name="ToRepresentativeId" asp-items="bulkForm.Representatives" class="form-select" required>
                                <option value="">-- select --</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Reason</label>
                            <input name="Reason" class="form-control" />
                        </div>
                        <div class="col-12">
                            <button type="submit" class="btn btn-sm btn-warning"><i class="bi bi-people-fill"></i> Bulk Assign</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Kind</th>
                    <th>Name</th>
                    <th>City</th>
                    <th>Current Representative</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model.Members)
                {
                    <tr>
                        <td><i class="bi @(m.Kind == "Doctor" ? "bi-heart-pulse" : "bi-shop")"></i> @m.Kind</td>
                        <td>
                            @if (m.Kind == "Doctor")
                            {
                                <a asp-controller="Doctors" asp-action="Details" asp-route-id="@m.EntityId">@m.Name</a>
                            }
                            else
                            {
                                <a asp-controller="Pharmacies" asp-action="Details" asp-route-id="@m.EntityId">@m.Name</a>
                            }
                        </td>
                        <td>@m.City</td>
                        <td>@m.CurrentRepresentativeName</td>
                        <td class="text-end">
                            @if (m.ListItemId is { } itemId && (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.SalesManager) || User.IsInRole(Roles.DistrictManager)))
                            {
                                <form asp-action="RemoveMember" method="post" class="d-inline">
                                    <input type="hidden" name="listId" value="@Model.Id" />
                                    <input type="hidden" name="listItemId" value="@itemId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-x-lg"></i></button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (Model.Members.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-secondary py-4">No members.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
