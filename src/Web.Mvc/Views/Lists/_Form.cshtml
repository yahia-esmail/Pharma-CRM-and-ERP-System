@model ListFormViewModel

<input type="hidden" asp-for="Id" />
<div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="Type" class="form-label"></label>
        <select asp-for="Type" asp-items="Html.GetEnumSelectList<CustomerListType>()" class="form-select"></select>
    </div>
    <div class="col-md-3">
        <label asp-for="Mode" class="form-label"></label>
        <select asp-for="Mode" asp-items="Html.GetEnumSelectList<CustomerListMode>()" class="form-select" id="modeSelect"></select>
    </div>
    <div class="col-md-6">
        <label asp-for="OwnerRepresentativeId" class="form-label">Owner (Representative)</label>
        <select asp-for="OwnerRepresentativeId" asp-items="Model.Representatives" class="form-select">
            <option value="">-- none --</option>
        </select>
    </div>
</div>

<div class="mt-3 p-3 border rounded" id="dynamicFilterPanel">
    <h6 class="text-secondary mb-3">Dynamic list filter (ignored for Static lists)</h6>
    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="FilterTerritoryId" class="form-label">Territory</label>
            <select asp-for="FilterTerritoryId" asp-items="Model.Territories" class="form-select">
                <option value="">-- any --</option>
            </select>
        </div>
        <div class="col-md-4">
            <label asp-for="FilterClassificationId" class="form-label">Doctor Classification</label>
            <select asp-for="FilterClassificationId" asp-items="Model.Classifications" class="form-select">
                <option value="">-- any --</option>
            </select>
        </div>
        <div class="col-md-4">
            <label asp-for="FilterSegment" class="form-label">Pharmacy Segment</label>
            <input asp-for="FilterSegment" class="form-control" placeholder="A / B / C" />
        </div>
        <div class="col-md-4 form-check ms-2 mt-4">
            <input asp-for="FilterActiveOnly" class="form-check-input" />
            <label asp-for="FilterActiveOnly" class="form-check-label">Active customers only</label>
        </div>
    </div>
</div>

<div class="mt-4 d-flex gap-2">
    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Save</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</div>
