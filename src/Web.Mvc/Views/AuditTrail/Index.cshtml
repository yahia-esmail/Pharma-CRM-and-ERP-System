@using PharmaERP.Domain.Entities
@model List<AuditLog>
@{
    ViewData["Title"] = "Audit Trail";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Audit Trail</h4>
    <a asp-action="Export" asp-route-entityType="@ViewBag.EntityType" asp-route-entityId="@ViewBag.EntityId" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-file-earmark-spreadsheet"></i> Export to Excel
    </a>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2">
            <div class="col-md-4">
                <input type="text" name="entityType" value="@ViewBag.EntityType" class="form-control" placeholder="Entity type (e.g. Doctor)" />
            </div>
            <div class="col-md-4">
                <input type="text" name="entityId" value="@ViewBag.EntityId" class="form-control" placeholder="Entity id" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-outline-secondary w-100"><i class="bi bi-search"></i> Filter</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-sm mb-0">
            <thead>
                <tr><th>Timestamp (UTC)</th><th>Entity</th><th>Action</th><th>By</th><th>Old Values</th><th>New Values</th></tr>
            </thead>
            <tbody>
                @foreach (var log in Model)
                {
                    <tr>
                        <td class="text-nowrap">@log.TimestampUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>@log.EntityType #@log.EntityId</td>
                        <td>
                            <span class="badge @(log.Action switch { PharmaERP.Domain.Enums.AuditAction.Create => "bg-success", PharmaERP.Domain.Enums.AuditAction.Delete => "bg-danger", _ => "bg-info" }) status-badge">@log.Action</span>
                        </td>
                        <td>@log.PerformedByUserId</td>
                        <td><small class="text-secondary">@log.OldValuesJson</small></td>
                        <td><small class="text-secondary">@log.NewValuesJson</small></td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-secondary py-4">No audit entries found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<nav class="mt-3">
    <ul class="pagination pagination-sm">
        @if ((int)ViewBag.Page > 1)
        {
            <li class="page-item"><a class="page-link" href="@Url.Action("Index", new { page = (int)ViewBag.Page - 1, entityType = ViewBag.EntityType, entityId = ViewBag.EntityId })">Previous</a></li>
        }
        @if ((bool)ViewBag.HasMore)
        {
            <li class="page-item"><a class="page-link" href="@Url.Action("Index", new { page = (int)ViewBag.Page + 1, entityType = ViewBag.EntityType, entityId = ViewBag.EntityId })">Next</a></li>
        }
    </ul>
</nav>
