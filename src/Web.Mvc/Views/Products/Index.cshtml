@model PagedResult<ProductListItemDto>
@{
    ViewData["Title"] = "Products";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Products</h4>
    @if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Warehouse))
    {
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> Add Product</a>
    }
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2">
            <div class="col-md-4">
                <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by name or SKU..." />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-outline-secondary w-100"><i class="bi bi-search"></i> Filter</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr><th>SKU</th><th>Name</th><th>Category</th><th>UoM</th><th>Unit Price</th></tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Items)
                {
                    <tr style="cursor:pointer;" onclick="location.href='@Url.Action("Details", new { id = p.Id })'">
                        <td>@p.Sku</td>
                        <td>@p.Name</td>
                        <td>@p.Category</td>
                        <td>@p.UnitOfMeasure</td>
                        <td>@p.UnitPrice.ToString("C")</td>
                    </tr>
                }
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-secondary py-4">No products found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination pagination-sm">
            @for (var p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { page = p, search = ViewBag.Search })">@p</a>
                </li>
            }
        </ul>
    </nav>
}
