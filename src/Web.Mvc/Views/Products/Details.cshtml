@model ProductDetailDto
@{
    ViewData["Title"] = Model.Name;
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h4 class="mb-0">@Model.Name</h4>
        <div class="text-secondary">@Model.Sku &mdash; @Model.Category</div>
    </div>
    @if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Warehouse))
    {
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm"><i class="bi bi-pencil"></i> Edit</a>
    }
</div>

<div class="card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Unit of Measure</dt><dd class="col-sm-9">@Model.UnitOfMeasure</dd>
            <dt class="col-sm-3">Unit Cost</dt><dd class="col-sm-9">@Model.UnitCost.ToString("C")</dd>
            <dt class="col-sm-3">Unit Price</dt><dd class="col-sm-9">@Model.UnitPrice.ToString("C")</dd>
            <dt class="col-sm-3">Reorder Level</dt><dd class="col-sm-9">@Model.ReorderLevel</dd>
            <dt class="col-sm-3">Batch Tracked</dt><dd class="col-sm-9">@(Model.IsBatchTracked ? "Yes" : "No")</dd>
            <dt class="col-sm-3">Expiry Tracked</dt><dd class="col-sm-9">@(Model.IsExpiryTracked ? "Yes" : "No")</dd>
        </dl>
    </div>
</div>

<div class="alert alert-info mt-3">
    <i class="bi bi-info-circle"></i> Batch/lot tracking, warehouse stock levels, and expiry alerts arrive with the Inventory module in Phase 4.
</div>
