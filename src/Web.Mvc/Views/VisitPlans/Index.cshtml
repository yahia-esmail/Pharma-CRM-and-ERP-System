@model PagedResult<VisitPlanListItemDto>
@{
    ViewData["Title"] = "Visit Plans";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Visit Plans</h4>
    @if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.SalesManager) || User.IsInRole(Roles.DistrictManager) || User.IsInRole(Roles.Representative))
    {
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> New Plan</a>
    }
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2">
            <div class="col-md-3">
                <select name="status" class="form-select" onchange="this.form.submit()" asp-items="Html.GetEnumSelectList<PharmaERP.Domain.Enums.VisitPlanStatus>()">
                    <option value="">-- any status --</option>
                </select>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr><th>Representative</th><th>Period</th><th>Dates</th><th>Items</th><th>Status</th></tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Items)
                {
                    <tr style="cursor:pointer;" onclick="location.href='@Url.Action("Details", new { id = p.Id })'">
                        <td>@p.RepresentativeName</td>
                        <td>@p.PeriodType</td>
                        <td>@p.StartDate.ToString("yyyy-MM-dd") &ndash; @p.EndDate.ToString("yyyy-MM-dd")</td>
                        <td>@p.ItemCount</td>
                        <td>
                            @{
                                var badgeClass = p.Status switch
                                {
                                    PharmaERP.Domain.Enums.VisitPlanStatus.Approved => "bg-success",
                                    PharmaERP.Domain.Enums.VisitPlanStatus.Submitted => "bg-info",
                                    PharmaERP.Domain.Enums.VisitPlanStatus.Rejected => "bg-danger",
                                    _ => "bg-secondary"
                                };
                            }
                            <span class="badge @badgeClass status-badge">@p.Status</span>
                        </td>
                    </tr>
                }
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-secondary py-4">No visit plans found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination pagination-sm">
            @for (var p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { page = p, status = ViewBag.Status })">@p</a>
                </li>
            }
        </ul>
    </nav>
}
