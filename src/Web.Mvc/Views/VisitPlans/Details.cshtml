@model VisitPlanDetailsViewModel
@{
    ViewData["Title"] = $"Visit Plan #{Model.Plan.Id}";
    var plan = Model.Plan;
    var editable = plan.Status is PharmaERP.Domain.Enums.VisitPlanStatus.Draft or PharmaERP.Domain.Enums.VisitPlanStatus.Rejected;
    var badgeClass = plan.Status switch
    {
        PharmaERP.Domain.Enums.VisitPlanStatus.Approved => "bg-success",
        PharmaERP.Domain.Enums.VisitPlanStatus.Submitted => "bg-info",
        PharmaERP.Domain.Enums.VisitPlanStatus.Rejected => "bg-danger",
        _ => "bg-secondary"
    };
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h4 class="mb-0">@plan.RepresentativeName &mdash; @plan.PeriodType Plan</h4>
        <div class="text-secondary">@plan.StartDate.ToString("yyyy-MM-dd") &ndash; @plan.EndDate.ToString("yyyy-MM-dd")</div>
    </div>
    <span class="badge @badgeClass status-badge fs-6">@plan.Status</span>
</div>

@if (plan.Status == PharmaERP.Domain.Enums.VisitPlanStatus.Rejected && plan.RejectionReason is not null)
{
    <div class="alert alert-danger"><strong>Rejection reason:</strong> @plan.RejectionReason</div>
}

<div class="d-flex gap-2 mb-3">
    @if (editable && (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.SalesManager) || User.IsInRole(Roles.DistrictManager) || User.IsInRole(Roles.Representative)))
    {
        <form asp-action="Submit" asp-route-id="@plan.Id" method="post" onsubmit="return confirm('Submit this plan for approval?');">
            <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-send"></i> Submit for Approval</button>
        </form>
    }
    @if (plan.Status == PharmaERP.Domain.Enums.VisitPlanStatus.Submitted && (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.SalesManager) || User.IsInRole(Roles.DistrictManager)))
    {
        <form asp-action="Approve" asp-route-id="@plan.Id" method="post" onsubmit="return confirm('Approve this plan?');">
            <button type="submit" class="btn btn-success btn-sm"><i class="bi bi-check-lg"></i> Approve</button>
        </form>
        <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#rejectModal">
            <i class="bi bi-x-lg"></i> Reject
        </button>
    }
</div>

<div class="card mb-3">
    <div class="table-responsive">
        <table class="table table-sm mb-0">
            <thead><tr><th>#</th><th>Doctor</th><th>Planned Date</th><th>Notes</th>@if (editable) {<th></th>}</tr></thead>
            <tbody>
                @foreach (var item in plan.Items)
                {
                    <tr>
                        <td>@item.Sequence</td>
                        <td>@item.DoctorName</td>
                        <td>@item.PlannedDate.ToString("yyyy-MM-dd")</td>
                        <td>@item.Notes</td>
                        @if (editable)
                        {
                            <td>
                                <form asp-action="RemoveItem" method="post" class="d-inline">
                                    <input type="hidden" name="visitPlanId" value="@plan.Id" />
                                    <input type="hidden" name="itemId" value="@item.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        }
                    </tr>
                }
                @if (plan.Items.Count == 0)
                {
                    <tr><td colspan="@(editable ? 5 : 4)" class="text-center text-secondary py-3">No planned visits yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (editable)
{
    <div class="card mb-3">
        <div class="card-body">
            <h6 class="card-title">Add Planned Visit</h6>
            <form asp-action="AddItem" method="post" class="row g-2">
                <input type="hidden" asp-for="NewItem.VisitPlanId" />
                <div class="col-md-4">
                    <select asp-for="NewItem.DoctorId" asp-items="Model.Doctors" class="form-select">
                        <option value="">-- select doctor --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <input asp-for="NewItem.PlannedDate" class="form-control" />
                </div>
                <div class="col-md-2">
                    <input asp-for="NewItem.Sequence" class="form-control" placeholder="Seq." />
                </div>
                <div class="col-md-3">
                    <input asp-for="NewItem.Notes" class="form-control" placeholder="Notes" />
                </div>
                <div class="col-12">
                    <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> Add</button>
                </div>
            </form>
        </div>
    </div>
}

@if (Model.PlanVsActual is not null)
{
    var pva = Model.PlanVsActual;
    <div class="card">
        <div class="card-body">
            <h6 class="card-title">Planned vs. Actual</h6>
            <p class="mb-2">
                <span class="fw-semibold">@pva.VisitedCount / @pva.PlannedCount</span> visited
                &mdash; <span class="fw-semibold">@pva.CoveragePercent%</span> coverage
            </p>
            <table class="table table-sm mb-0">
                <thead><tr><th>Doctor</th><th>Planned Date</th><th>Result</th></tr></thead>
                <tbody>
                    @foreach (var v in pva.Items)
                    {
                        <tr>
                            <td>@v.DoctorName</td>
                            <td>@v.PlannedDate.ToString("yyyy-MM-dd")</td>
                            <td>
                                @if (v.Visited)
                                {
                                    <span class="badge bg-success status-badge">Visited</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning status-badge">Missed</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Reject" method="post">
                <input type="hidden" name="VisitPlanId" value="@plan.Id" />
                <div class="modal-header">
                    <h5 class="modal-title">Reject Plan</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label">Reason</label>
                    <textarea name="Reason" class="form-control" rows="3" required></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Reject</button>
                </div>
            </form>
        </div>
    </div>
</div>
