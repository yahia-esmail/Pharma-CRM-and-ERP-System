@model IReadOnlyList<ProductBatchDto>
@{
    ViewData["Title"] = "Product Batches";
    var products = (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Products;
}

<h4 class="mb-3">Product Batches</h4>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2">
            <div class="col-md-4">
                <select name="productId" class="form-select" onchange="this.form.submit()" asp-items="products">
                    <option value="">-- all products --</option>
                </select>
            </div>
        </form>
    </div>
</div>

@if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Warehouse))
{
    <div class="card mb-3">
        <div class="card-body">
            <h6 class="card-title">Register New Batch</h6>
            <form asp-action="CreateBatch" method="post" class="row g-2">
                <div class="col-md-4">
                    <select name="ProductId" asp-items="products" class="form-select">
                        <option value="">-- select product --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <input name="BatchNumber" class="form-control" placeholder="Batch number" />
                </div>
                <div class="col-md-2">
                    <input name="ManufactureDate" type="date" class="form-control" />
                </div>
                <div class="col-md-2">
                    <input name="ExpiryDate" type="date" class="form-control" />
                </div>
                <div class="col-md-1">
                    <button type="submit" class="btn btn-primary btn-sm w-100"><i class="bi bi-plus-lg"></i></button>
                </div>
            </form>
        </div>
    </div>
}

<div class="card">
    <div class="table-responsive">
        <table class="table table-sm mb-0">
            <thead><tr><th>Product</th><th>Batch #</th><th>Manufactured</th><th>Expiry</th><th></th></tr></thead>
            <tbody>
                @foreach (var b in Model)
                {
                    <tr>
                        <td>@b.ProductName</td>
                        <td>@b.BatchNumber</td>
                        <td>@b.ManufactureDate?.ToString("yyyy-MM-dd")</td>
                        <td>@b.ExpiryDate.ToString("yyyy-MM-dd")</td>
                        <td><a asp-controller="Trace" asp-action="Batch" asp-route-id="@b.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-diagram-3"></i> Trace</a></td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-secondary py-4">No batches registered.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
