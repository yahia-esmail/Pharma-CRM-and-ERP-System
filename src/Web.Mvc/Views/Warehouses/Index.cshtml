@model IReadOnlyList<WarehouseListItemDto>
@{
    ViewData["Title"] = "Warehouses";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Warehouses</h4>
    <div class="d-flex gap-2">
        <a asp-action="StockLevels" class="btn btn-outline-secondary btn-sm"><i class="bi bi-bar-chart"></i> Stock Levels</a>
        <a asp-action="Movements" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left-right"></i> Movements</a>
        <a asp-action="Reports" class="btn btn-outline-secondary btn-sm"><i class="bi bi-exclamation-triangle"></i> Alerts</a>
        <a asp-action="Batches" class="btn btn-outline-secondary btn-sm"><i class="bi bi-upc-scan"></i> Batches</a>
        @if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Warehouse))
        {
            <a asp-action="Operations" class="btn btn-primary btn-sm"><i class="bi bi-box-arrow-in-down"></i> Operations</a>
            <a asp-action="Create" class="btn btn-outline-primary btn-sm"><i class="bi bi-plus-lg"></i> Add Warehouse</a>
        }
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Name</th><th>Location</th><th>Type</th><th></th></tr></thead>
            <tbody>
                @foreach (var w in Model)
                {
                    <tr>
                        <td>@w.Name</td>
                        <td>@w.Location</td>
                        <td>@w.Type</td>
                        <td class="text-end">
                            @if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Warehouse))
                            {
                                <a asp-action="Edit" asp-route-id="@w.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i></a>
                                <form asp-action="Delete" asp-route-id="@w.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this warehouse?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="4" class="text-center text-secondary py-4">No warehouses defined.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
