@model RepresentativeFormViewModel

<input type="hidden" asp-for="Id" />
<div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

<div class="row g-3">
    <div class="col-md-4">
        <label asp-for="EmployeeCode" class="form-label"></label>
        <input asp-for="EmployeeCode" class="form-control" />
        <span asp-validation-for="EmployeeCode" class="text-danger"></span>
    </div>
    <div class="col-md-8">
        <label asp-for="FullName" class="form-label"></label>
        <input asp-for="FullName" class="form-control" />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Level" class="form-label"></label>
        <select asp-for="Level" asp-items="Html.GetEnumSelectList<PharmaERP.Domain.Enums.RepresentativeLevel>()" class="form-select"></select>
    </div>
    <div class="col-md-4">
        <label asp-for="EmploymentStatus" class="form-label"></label>
        <select asp-for="EmploymentStatus" asp-items="Html.GetEnumSelectList<PharmaERP.Domain.Enums.EmploymentStatus>()" class="form-select"></select>
    </div>
    <div class="col-md-4">
        <label asp-for="TerritoryId" class="form-label"></label>
        <select asp-for="TerritoryId" asp-items="Model.Territories" class="form-select">
            <option value="">-- none --</option>
        </select>
    </div>
    <div class="col-md-6">
        <label asp-for="ReportingManagerId" class="form-label"></label>
        <select asp-for="ReportingManagerId" asp-items="Model.Managers" class="form-select">
            <option value="">-- none --</option>
        </select>
    </div>
    <div class="col-md-3">
        <label asp-for="Phone" class="form-label"></label>
        <input asp-for="Phone" class="form-control" />
    </div>
    <div class="col-md-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
</div>

<hr class="my-3" />
<h6>Login Access</h6>
@if (!string.IsNullOrEmpty(Model.ApplicationUserId))
{
    <p class="text-muted mb-0"><i class="bi bi-check-circle text-success"></i> Already linked to a login account.</p>
}
else
{
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="LoginPassword" class="form-label">Create login password</label>
            <input asp-for="LoginPassword" type="password" class="form-control" autocomplete="new-password" />
            <div class="form-text">Optional. Set a password to automatically create a website/mobile login for this representative using the email above. Leave blank to skip.</div>
            <span asp-validation-for="LoginPassword" class="text-danger"></span>
        </div>
    </div>
}

<div class="mt-4 d-flex gap-2">
    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Save</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</div>
